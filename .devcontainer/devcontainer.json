{
  "name": "PrereqPilot (FastAPI + React)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {}
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "api/main.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "pip3 install --user -r requirements.txt && npm --prefix frontend install",
  "postAttachCommand": {
    "api": "uvicorn api.main:app --reload --host 0.0.0.0 --port 8000"
  },
  "portsAttributes": {
    "8000": {
      "label": "API (FastAPI)",
      "onAutoForward": "notify"
    },
    "3000": {
      "label": "Frontend (Vite)",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8000,
    3000
  ]
}
